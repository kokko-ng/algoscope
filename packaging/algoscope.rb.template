# Homebrew formula for algoscope. Generated by scripts/update-tap.sh from the GitHub Release; do not
# edit the copy in the tap by hand.
class Algoscope < Formula
  desc "Terminal workbench for data structures, algorithms and system design"
  homepage "https://github.com/kokko-ng/algoscope"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/kokko-ng/algoscope/releases/download/v@VERSION@/algoscope-v@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_aarch64-apple-darwin@"
    end
    on_intel do
      url "https://github.com/kokko-ng/algoscope/releases/download/v@VERSION@/algoscope-v@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_x86_64-apple-darwin@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/kokko-ng/algoscope/releases/download/v@VERSION@/algoscope-v@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_aarch64-unknown-linux-gnu@"
    end
    on_intel do
      url "https://github.com/kokko-ng/algoscope/releases/download/v@VERSION@/algoscope-v@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_x86_64-unknown-linux-gnu@"
    end
  end

  # solutions run on Python; pin the interpreter so a system Python older than 3.10 is never used
  depends_on "python@3.13"

  def install
    libexec.install "algoscope"
    (bin/"algoscope").write_env_script libexec/"algoscope",
      ALGOSCOPE_PYTHON: Formula["python@3.13"].opt_bin/"python3.13"
    doc.install "README.md"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/algoscope --version")
    assert_match "challenges checked, 0 with problems", shell_output("#{bin}/algoscope check-content --topic estimation")
  end
end
